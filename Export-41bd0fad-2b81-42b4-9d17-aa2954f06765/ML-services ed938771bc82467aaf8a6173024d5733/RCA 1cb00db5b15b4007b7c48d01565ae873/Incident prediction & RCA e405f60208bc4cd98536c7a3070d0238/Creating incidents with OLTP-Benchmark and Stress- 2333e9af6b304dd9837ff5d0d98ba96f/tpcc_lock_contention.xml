<?xml version="1.0"?>
<parameters>
	
    <!-- Connection details -->
    <dbtype>mysql</dbtype>
    <driver>com.mysql.jdbc.Driver</driver>
    <DBUrl>jdbc:mysql://localhost:3306/tpcc?useSSL=false</DBUrl>
    <username>root</username>
    <password>MySQL</password>
    <isolation>TRANSACTION_SERIALIZABLE</isolation>
    <uploadCode></uploadCode>
    <uploadUrl></uploadUrl>
    
    <!-- Only one warehouse increases lock contention -->
    <scalefactor>1</scalefactor>
    
    <!-- The workload -->
    <terminals>2</terminals>
    <works>
        <work>
          <time>600</time>
          <rate>10000</rate>
          <weights>100</weights>
        </work>
    </works>
	
	<!-- TPCC specific -->  
	<!-- Only NewOrder transactions increases lock contention -->
   	<transactiontypes>
    	<transactiontype>
    		<name>NewOrder</name>
    	</transactiontype>
   	</transactiontypes>	
</parameters>
