## Required
# Anthropic API key used by the classifier
ANTHROPIC_API_KEY=

## Optional (defaults shown)
# Anthropic model id (see README for suggestions)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Rows per batch for inventory classification
SEGMENTER_BATCH_SIZE=25

# Max characters of each description/snippet sent to the model
SEGMENTER_SNIPPET_CHARS=1200

# Retries for transient Anthropic errors (timeouts, 529 overload, rate limits)
SEGMENTER_MAX_RETRIES=8
SEGMENTER_RETRY_BASE_SECONDS=0.75
SEGMENTER_RETRY_MAX_SECONDS=90
SEGMENTER_SUMMARY_MAX_RETRIES=8
SEGMENTER_SUMMARY_RETRY_BASE_SECONDS=0.75
SEGMENTER_SUMMARY_RETRY_MAX_SECONDS=90

